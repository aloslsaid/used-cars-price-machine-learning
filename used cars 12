import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.impute import SimpleImputer

from sklearn.linear_model import LinearRegression, Ridge
from sklearn.tree import DecisionTreeRegressor
from sklearn.ensemble import (
    RandomForestRegressor,
    ExtraTreesRegressor,
    GradientBoostingRegressor
)

from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

df = pd.read_csv("cars.csv")
df = df.drop_duplicates()

df["selling_price"] = pd.to_numeric(
    df["selling_price"], errors="coerce"
)
df = df.dropna(subset=["selling_price"])
df = df[df["selling_price"] > 0]

numeric_text_columns = [
    "year", "km_driven", "mileage",
    "engine", "max_power", "seats"
]

for col in numeric_text_columns:
    if col in df.columns:
        df[col] = pd.to_numeric(
            df[col].astype(str).str.extract(
                r"([-+]?\d*\.?\d+)"
            )[0],
            errors="coerce"
        )

X = df.drop(columns=["selling_price"])
y = df["selling_price"]

X_train_full, X_test, y_train_full, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

X_train, X_val, y_train, y_val = train_test_split(
    X_train_full,
    y_train_full,
    test_size=0.25,
    random_state=42
)

categorical_columns = X_train.select_dtypes(
    include=["object", "category", "bool"]
).columns.tolist()

numerical_columns = [
    col for col in X_train.columns
    if col not in categorical_columns
]

try:
    encoder = OneHotEncoder(
        handle_unknown="ignore",
        sparse_output=False
    )
except TypeError:
    encoder = OneHotEncoder(
        handle_unknown="ignore",
        sparse=False
    )

def create_pipeline(model):
    numeric_preprocessor = Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ])

    categorical_preprocessor = Pipeline([
        ("imputer", SimpleImputer(strategy="most_frequent")),
        ("encoder", encoder)
    ])

    preprocessor = ColumnTransformer([
        ("num", numeric_preprocessor, numerical_columns),
        ("cat", categorical_preprocessor, categorical_columns)
    ])

    return Pipeline([
        ("preprocessor", preprocessor),
        ("model", model)
    ])

models = {
    "Linear Regression": LinearRegression(),
    "Ridge Alpha 1": Ridge(alpha=1.0),
    "Ridge Alpha 10": Ridge(alpha=10.0),
    "Decision Tree 10": DecisionTreeRegressor(
        max_depth=10,
        min_samples_leaf=5,
        random_state=42
    ),
    "Decision Tree 20": DecisionTreeRegressor(
        max_depth=20,
        min_samples_leaf=3,
        random_state=42
    ),
    "Random Forest 200": RandomForestRegressor(
        n_estimators=200,
        min_samples_leaf=2,
        random_state=42,
        n_jobs=-1
    ),
    "Random Forest 400": RandomForestRegressor(
        n_estimators=400,
        min_samples_leaf=2,
        random_state=42,
        n_jobs=-1
    ),
    "Extra Trees": ExtraTreesRegressor(
        n_estimators=300,
        min_samples_leaf=2,
        random_state=42,
        n_jobs=-1
    ),
    "Gradient Boosting": GradientBoostingRegressor(
        n_estimators=200,
        learning_rate=0.05,
        max_depth=3,
        random_state=42
    )
}

results = []

for name, model in models.items():
    pipeline = create_pipeline(model)
    pipeline.fit(X_train, y_train)

    predictions = np.maximum(pipeline.predict(X_val), 0)
    actual = y_val.to_numpy()

    results.append({
        "Model": name,
        "MAE": mean_absolute_error(y_val, predictions),
        "RMSE": np.sqrt(mean_squared_error(y_val, predictions)),
        "R2": r2_score(y_val, predictions),
        "Within 10%": np.mean(
            np.abs(predictions - actual) / actual <= 0.10
        ) * 100,
        "Within 20%": np.mean(
            np.abs(predictions - actual) / actual <= 0.20
        ) * 100,
        "Within 30%": np.mean(
            np.abs(predictions - actual) / actual <= 0.30
        ) * 100
    })

results_df = pd.DataFrame(results).sort_values("MAE")
print("\n========== VALIDATION RESULTS ==========")
print(results_df.round(4).to_string(index=False))
results_df.to_csv("cars_model_comparison.csv", index=False)

best_name = results_df.iloc[0]["Model"]
print("\nBest model:", best_name)

final_model = create_pipeline(models[best_name])
final_model.fit(X_train_full, y_train_full)

test_predictions = np.maximum(final_model.predict(X_test), 0)
actual_test = y_test.to_numpy()

print("\n========== FINAL TEST RESULTS ==========")
print("Model:", best_name)
print(f"MAE: {mean_absolute_error(y_test, test_predictions):.2f}")
print(
    f"RMSE: {np.sqrt(mean_squared_error(y_test, test_predictions)):.2f}"
)
print(f"R2: {r2_score(y_test, test_predictions):.4f}")
print(
    f"Within 10%: {np.mean(np.abs(test_predictions - actual_test) / actual_test <= 0.10) * 100:.2f}%"
)
print(
    f"Within 20%: {np.mean(np.abs(test_predictions - actual_test) / actual_test <= 0.20) * 100:.2f}%"
)
print(
    f"Within 30%: {np.mean(np.abs(test_predictions - actual_test) / actual_test <= 0.30) * 100:.2f}%"
)

output = X_test.copy()
output["actual_price"] = y_test
output["predicted_price"] = test_predictions
output.to_csv("cars_test_predictions.csv", index=False)

print("\nSaved:")
print("cars_model_comparison.csv")
print("cars_test_predictions.csv")