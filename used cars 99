    errors="coerce"

)

df["engine_hp"] = df["engine_hp"].fillna(

    df["engine_hp"].median()

)

df["engine_liters"] = df["engine_liters"].fillna(

    df["engine_liters"].median()

)

df["milage"] = df["milage"].fillna(

    df["milage"].median()

)

df["age"] = df["age"].fillna(

    df["age"].median()

)

